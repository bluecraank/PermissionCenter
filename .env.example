# Kopieren nach .env und Werte anpassen. .env nicht einchecken!

# PostgreSQL
POSTGRES_DB=permcenter
POSTGRES_USER=permcenter
POSTGRES_PASSWORD=bitte-aendern

# Port der Web-Oberfläche/API auf dem Docker-Host
PC_PORT=8080

# Token(s), die Clients beim Upload senden müssen (kommagetrennt). Leer = ohne Token (nicht empfohlen).
PC_API_TOKENS=

# OTA-Updates der Clients: öffentlicher Schlüssel aus "pc-server gen-signing-key".
# Wenn gesetzt, nimmt der Server nur korrekt signierte Client-Releases an.
PC_CLIENT_UPDATE_PUBLIC_KEY=

# Active Directory (optional). Beispiel:
# PC_LDAP_URL=ldaps://dc01.firma.local:636
# PC_LDAP_BIND_DN=svc-permcenter@firma.local
# PC_LDAP_BIND_PASSWORD=geheim
# PC_LDAP_BASE_DN=DC=firma,DC=local
# PC_LDAP_SYNC_INTERVAL_MINUTES=60
PC_LDAP_URL=
PC_LDAP_BIND_DN=
PC_LDAP_BIND_PASSWORD=
PC_LDAP_BASE_DN=
PC_LDAP_SYNC_INTERVAL_MINUTES=0
